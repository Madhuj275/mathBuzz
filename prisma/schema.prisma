generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  totalXP         Int      @default(0)
  level           Int      @default(0)
  streak          Int      @default(0)
  lastStreakDate  DateTime?
  badges          Badge[]
  answers         Answer[]
  xpLogs          XPLog[]
}

model DailyChallenge {
  id        String   @id @default(uuid())
  date      DateTime @unique // UTC date (no time component)
  puzzle0   String   // Serialized puzzle data (could be JSON string)
  puzzle1   String
  puzzle2   String
}

model Answer {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  date          DateTime // UTC date of the challenge
  puzzleIndex   Int      // 0,1,2
  correct       Boolean
  submittedAt   DateTime @default(now())
  @@unique([userId, date, puzzleIndex])
}

model Badge {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // e.g., "first_challenge", "seven_day_streak", "thirty_challenges"
  earnedAt  DateTime @default(now())
  @@unique([userId, type])
}

model XPLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  amount    Int      // XP gained in this event
  reason    String   // e.g., "daily_correct", "streak_bonus"
  createdAt DateTime @default(now())
}
